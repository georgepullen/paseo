{
  "compilerOptions": {
    "paths": {
      "paseo-plugin-helper/core": ["../paseo-plugin-helper/src/core/index.ts"],
      "paseo-plugin-helper/shared": ["../paseo-plugin-helper/src/shared/index.ts"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
