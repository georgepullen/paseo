{
  "name": "@xpufx/uppidi-fleet-web",
  "version": "0.1.0",
  "description": "Standalone uppidi-fleet web dashboard (uncoupled from the Paseo desktop plugin shell). Connects to the Paseo daemon over WebSocket/HTTP.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@getpaseo/client": "^0.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.2"
  }
}
