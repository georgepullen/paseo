# Copy to `.env` and adjust. Vite exposes only `VITE_*` vars to the browser.
VITE_PASEO_DAEMON_HOST=10.20.30.24:6767
# Optional full override (takes precedence when set):
# VITE_PASEO_DAEMON_URL=ws://10.20.30.24:6767
# Optional daemon password/token when the daemon requires auth:
# VITE_PASEO_DAEMON_TOKEN=
# Web server bind host (defaults to 0.0.0.0):
# HOST=0.0.0.0
